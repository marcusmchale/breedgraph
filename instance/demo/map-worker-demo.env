# /opt/map_worker/map-worker-demo.env on the worker server (mode 0600, as production's map_worker.env): the
# demonstration site's map worker (map-worker-demo.service), beside production's. It reaches the site's API at the
# site's address, where nginx passes /demo/map_jobs/ to it for this server alone (nginx-breedgraph-demo.conf). The token is the one in
# breedgraph-demo.env. Its work path is its own, as a worker empties its work path when it starts. The cache is
# production's worker's, so a region either site has had is sent again rather than cut again.
API_URL="https://<site>/demo"
MAP_WORKER_AUTH_TOKEN="<the site's MAP_WORKER_AUTH_TOKEN>"
MAP_POLL_INTERVAL=5
MAP_WORK_PATH="/srv/map_worker/work-demo"
MAP_CACHE_PATH="/srv/map_worker/cache"
MAP_PMTILES_COMMAND="pmtiles"
GEOBOUNDARIES_URL="https://www.geoboundaries.org/api/current/gbOpen"
PROTOMAPS_BUILDS_URL="https://build-metadata.protomaps.dev/builds.json"
LOG_BASE="/var/log/map_worker"
MAP_LOG="map-demo.log"
LOG_LEVEL="INFO"
