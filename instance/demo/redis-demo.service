# /etc/systemd/system/redis-demo.service: the demonstration site's Redis (instance/demo/redis-demo.conf); started with
# breedgraph-demo.target
[Unit]
Description=Redis for the BreedGraph demonstration site
After=network.target
PartOf=breedgraph-demo.target

[Service]
# within the site's share of the machine (breedgraph-demo.slice)
Slice=breedgraph-demo.slice
Type=notify
User=breedgraph-demo
Group=breedgraph-demo
ExecStart=/usr/bin/redis-server /etc/redis/redis-demo.conf
Restart=on-failure
