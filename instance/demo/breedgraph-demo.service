# /etc/systemd/system/breedgraph-demo.service: the demonstration site's API, as instance/breedgraph.service runs
# production's, on 127.0.0.1:8001 behind nginx
[Unit]
Description=BreedGraph demonstration site
After=network.target neo4j-demo.service redis-demo.service
Requires=network.target neo4j-demo.service redis-demo.service

[Service]
User=breedgraph-demo
Group=breedgraph-demo
WorkingDirectory=/opt/breedgraph-demo/checkout
EnvironmentFile=/opt/breedgraph-demo/breedgraph-demo.env
ExecStart=/opt/breedgraph-demo/checkout/.venv/bin/uvicorn \
    breedgraph.main:app \
    --app-dir src \
    --host 127.0.0.1 \
    --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
