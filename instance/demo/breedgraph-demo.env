# /opt/breedgraph-demo/breedgraph-demo.env (mode 0600, owned by breedgraph-demo): the hosted demonstration site's
# environment, for its API, its analysis worker and scripts/reset_demo.sh (instance/demo/README.md). Every secret here
# is the site's own: share none with production. Values in <angle brackets> are to fill in.

# Marks the demonstration site: scripts/reset_demo.sh and scripts/set_demo_accounts.py refuse to run without it
BREEDGRAPH_DEMO=1

ENVIRONMENT="production"
LOG_LEVEL="INFO"

# The second Neo4j (instance/demo/neo4j.conf) and Redis (redis-demo.conf), beside production's 7687 and 6379
DATABASE_NAME="neo4j"
DB_HOST=127.0.0.1
DB_PORT=7688
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="<the demo Neo4j's password>"
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Real mail, so that invitations and verifications reach reviewers
MAIL_HOST='<smtp host>'
MAIL_PORT=465
MAIL_USERNAME="<smtp user>"
MAIL_PASSWORD="<smtp password>"
MAIL_FROM="<the address the site writes from>"
MAIL_USE_TLS=1
MAIL_AUTHENTICATED=1

LOG_BASE="/opt/breedgraph-demo/logs"
BREEDGRAPH_LOG="breedgraph.log"
GRAPHQL_LOG="graphql.log"
NEO4J_LOG="neo4j.log"
REDIS_LOG="redis.log"

# Rotated by each reset (scripts/reset_demo.sh), so no login cookie outlives it
SECRET_KEY="<rotated nightly>"
VERIFY_TOKEN_SALT="<salt>"
VERIFY_EXPIRES=1440
PASSWORD_RESET_SALT="<salt>"
PASSWORD_RESET_EXPIRES=60
LOGIN_SALT="<salt>"
LOGIN_EXPIRES=10080
CSRF_SALT="<salt>"
CSRF_EXPIRES=3600
ACCEPTANCE_SALT="<salt>"
ACCEPTANCE_EXPIRES_SIGNED_IN=525600
ACCEPTANCE_EXPIRES_ANONYMOUS=10080

# At /demo/ on production's host, over its HTTPS (instance/demo/README.md, The address): the API listens on
# 127.0.0.1:8001 behind nginx, which strips /demo from its requests and serves BreedView from the same origin. The
# ports are the public ones, as they only make the links the API gives (emails, verify, reset, downloads), and
# SITE_PATH starts them. Its cookies are named demo_... and set for /demo/, as a browser sends the host's cookies to
# every path: production's are never read or overwritten here, nor the site's sent to production.
PROTOCOL="https"
SITE_NAME='BreedGraph demonstration'
HOST_ADDRESS='breedgraph.universityofgalway.ie'
HOST_PORT=443
GRAPHQL_API_PATH='graphql'
VUE_PORT=443
SITE_PATH='/demo'
COOKIE_PREFIX='demo_'

FILE_STORAGE_PATH="/opt/breedgraph-demo/files"
FILE_DOWNLOAD_SALT="<salt>"
FILE_DOWNLOAD_EXPIRES=1440
MAX_CONCURRENT_UPLOADS=5
LEGAL_FILE_SIZE_LIMIT=5000000
LEGAL_FILE_PAGE_LIMIT=200

# The site's own archive worker (archive-worker-demo.service, whose env file has the same token), on this machine, and
# its own encryption key, never production's: age-keygen -o /opt/breedgraph-demo/private/encryption_key.txt as
# breedgraph-demo, and its public key here. No backups: the dump is the site's backup, loaded again each night, and
# nothing calls the retention route, as no file outlives a night.
ARCHIVE_AUTH_TOKEN="<token>"
RETENTION_AUTH_TOKEN="<token>"
LOCAL_STORAGE_DURATION=28
LOCAL_SIZE_LIMIT=10000000
NEO4J_ARCHIVE_PATH=""
ENCRYPTION_RECIPIENT="<age1… the site's public key>"
ENCRYPTION_IDENTITY_PATH="/opt/breedgraph-demo/private/encryption_key.txt"

# Emptied by each reset, and never replayed: the people erased on the site go with the site's data
PERSON_ERASURE_LOG_PATH="/opt/breedgraph-demo/logs/person_erasure_log.jsonl"

# Written by each reset: instance/demo/legal-preamble.md, then the drafts in docs/legal/, so that reviewers read what
# they are reviewing
TERMS_OF_USE_PATH="/opt/breedgraph-demo/legal/terms_of_use.md"
PRIVACY_NOTICE_PATH="/opt/breedgraph-demo/legal/privacy_notice.md"

# Maps and the place search's places (docs/maps.md): the site's own, fetched by its own map worker
# (map-worker-demo.service, whose env file has the same token), on the worker server, as this one can't reach the
# internet. Each reset restores the dump's maps (the world and Ireland's region), and deletes the places, which the API
# fetches again (the world's and Ireland's), so a region or places a visitor fetches last until then. The regions
# together are held to MAP_TILES_MAX_GB, as the site shares production's disk; put MAP_TILES_PATH, GAZETTEER_PATH and
# DEMO_DUMP_DIR, which keeps a copy of the maps, on a disk with room (README.md here, Setting it up).
MAP_TILES_PATH="/opt/breedgraph-demo/map_tiles"
MAP_REGION_MAX_GB=2
MAP_TILES_MAX_GB=10
MAP_TILES_BUILD="latest"
MAP_PMTILES_COMMAND=""
MAP_BOUNDARIES_PATH="/opt/breedgraph-demo/map_boundaries"
MAP_WORKER=1
MAP_WORKER_AUTH_TOKEN="<token>"
MAP_JOB_LEASE_SECONDS=300
GAZETTEER_PATH="/opt/breedgraph-demo/gazetteer"
GEONAMES_URL=""

INVITATION_EXPIRY_DAYS=1
INVITATION_SALT="<salt>"
# the site's visitors invite few people, and its mail goes out from production's server
EMAIL_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
MESSAGE_RATE_LIMIT_PER_HOUR=10
MESSAGE_MAX_LENGTH=5000
MESSAGE_SUBJECT_MAX_LENGTH=200

# No ORCID linking on the demonstration site
ORCID_CLIENT_ID=""

# The site's analysis worker (analysis-worker-demo.service), whose env file has the same token
ANALYSIS_WORKER_AUTH_TOKEN="<token>"

# scripts/reset_demo.sh: the dump (neo4j.dump, with the file store's files and the site's maps in files/, map_tiles/ and
# map_boundaries/), the accounts file, the checkout, the archive worker's store, Neo4j's installation and the
# services' target
DEMO_ROOT="/opt/breedgraph-demo"
DEMO_DUMP_DIR="/opt/breedgraph-demo/dump"
DEMO_ACCOUNTS="/opt/breedgraph-demo/private/demo_accounts.json"
DEMO_CHECKOUT="/opt/breedgraph-demo/checkout"
DEMO_ARCHIVE_DIR="/opt/breedgraph-demo/archive"
NEO4J_PACKAGE="/usr/share/neo4j"
DEMO_TARGET="breedgraph-demo.target"
