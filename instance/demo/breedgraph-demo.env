# /opt/breedgraph-demo/breedgraph-demo.env (mode 0600, owned by breedgraph-demo): the hosted demonstration site's
# environment, for its API, its analysis worker and scripts/reset_demo.sh (instance/demo/README.md). Every secret here
# is the site's own: share none with production. Values in <angle brackets> are to fill in.

# Marks the demonstration site: scripts/reset_demo.sh and scripts/set_demo_accounts.py refuse to run without it
BREEDGRAPH_DEMO=1

ENVIRONMENT="production"
LOG_LEVEL="INFO"

# The second Neo4j (instance/demo/neo4j.conf) and Redis (redis-demo.conf), beside production's 7687 and 6379
DATABASE_NAME="neo4j"
DB_HOST=127.0.0.1
DB_PORT=7688
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="<the demo Neo4j's password>"
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Real mail, so that invitations and verifications reach reviewers
MAIL_HOST='<smtp host>'
MAIL_PORT=465
MAIL_USERNAME="<smtp user>"
MAIL_PASSWORD="<smtp password>"
MAIL_FROM="<the address the site writes from>"
MAIL_USE_TLS=1
MAIL_AUTHENTICATED=1

LOG_BASE="/opt/breedgraph-demo/logs"
BREEDGRAPH_LOG="breedgraph.log"
GRAPHQL_LOG="graphql.log"
NEO4J_LOG="neo4j.log"
REDIS_LOG="redis.log"

# Rotated by each reset (scripts/reset_demo.sh), so no login cookie outlives it
SECRET_KEY="<rotated nightly>"
VERIFY_TOKEN_SALT="<salt>"
VERIFY_EXPIRES=1440
PASSWORD_RESET_SALT="<salt>"
PASSWORD_RESET_EXPIRES=60
LOGIN_SALT="<salt>"
LOGIN_EXPIRES=10080
CSRF_SALT="<salt>"
CSRF_EXPIRES=3600
ACCEPTANCE_SALT="<salt>"
ACCEPTANCE_EXPIRES_SIGNED_IN=525600
ACCEPTANCE_EXPIRES_ANONYMOUS=10080

# A sibling of production's host name, never a subdomain of it (instance/demo/README.md, The host name). The API
# listens on 127.0.0.1:8001 behind nginx, which serves BreedView from the same origin.
PROTOCOL="https"
SITE_NAME='BreedGraph demonstration'
HOST_ADDRESS='<breedgraph-demo.example.org>'
HOST_PORT=8001
GRAPHQL_API_PATH='graphql'
VUE_PORT=443

FILE_STORAGE_PATH="/opt/breedgraph-demo/files"
FILE_DOWNLOAD_SALT="<salt>"
FILE_DOWNLOAD_EXPIRES=1440
MAX_CONCURRENT_UPLOADS=5
LEGAL_FILE_SIZE_LIMIT=5000000
LEGAL_FILE_PAGE_LIMIT=200

# No archive worker and no backups: the dump is the site's backup, loaded again each night. The tokens guard the API's
# archive and retention routes, which nothing calls here.
ARCHIVE_AUTH_TOKEN="<token>"
RETENTION_AUTH_TOKEN="<token>"
LOCAL_STORAGE_DURATION=28
LOCAL_SIZE_LIMIT=10000000
COUNTRY_CODES_PATH="country_codes.csv"
NEO4J_ARCHIVE_PATH=""
ENCRYPTION_RECIPIENT=""
ENCRYPTION_IDENTITY_PATH=""

# Emptied by each reset, and never replayed: the people erased on the site go with the site's data
PERSON_ERASURE_LOG_PATH="/opt/breedgraph-demo/logs/person_erasure_log.jsonl"

# Written by each reset: instance/demo/legal-preamble.md, then the drafts in docs/legal/, so that reviewers read what
# they are reviewing
TERMS_OF_USE_PATH="/opt/breedgraph-demo/legal/terms_of_use.md"
PRIVACY_NOTICE_PATH="/opt/breedgraph-demo/legal/privacy_notice.md"

# The world and Ireland's region, cut elsewhere: the site fetches no regions itself
NOMINATIM_URL="https://nominatim.openstreetmap.org"
GEOCODING_RATE_LIMIT_PER_HOUR=60
MAP_TILES_PATH="/opt/breedgraph-demo/map_tiles"
MAP_REGION_MAX_GB=2
MAP_TILES_BUILD="latest"
MAP_PMTILES_COMMAND=""
MAP_BOUNDARIES_PATH="/opt/breedgraph-demo/map_boundaries"

INVITATION_EXPIRY_DAYS=1
INVITATION_SALT="<salt>"
MESSAGE_RATE_LIMIT_PER_HOUR=10
MESSAGE_MAX_LENGTH=5000
MESSAGE_SUBJECT_MAX_LENGTH=200

# No ORCID linking on the demonstration site
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# The analysis worker's (analysis-worker-demo.service), pointed at this API
ANALYSIS_WORKER_AUTH_TOKEN="<token>"
API_URL="http://127.0.0.1:8001"

# scripts/reset_demo.sh: the dump, its files, the accounts file, the checkout, Neo4j's installation and the services
DEMO_ROOT="/opt/breedgraph-demo"
DEMO_DUMP_DIR="/opt/breedgraph-demo/dump"
DEMO_FILES_DIR="/opt/breedgraph-demo/dump/files"
DEMO_ACCOUNTS="/opt/breedgraph-demo/private/demo_accounts.json"
DEMO_CHECKOUT="/opt/breedgraph-demo/checkout"
NEO4J_PACKAGE="/usr/share/neo4j"
DEMO_SERVICES="breedgraph-demo analysis-worker-demo"
