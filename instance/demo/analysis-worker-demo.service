# /etc/systemd/system/analysis-worker-demo.service: an analysis worker for the demonstration site's API, on this
# machine, as instance/analysis_worker.service runs production's (R with the packages it lists); started with
# breedgraph-demo.target. Its environment is its own (analysis-worker-demo.env), so it holds none of the API's secrets.
[Unit]
Description=Analysis worker for the BreedGraph demonstration site
After=network.target breedgraph-demo.service
PartOf=breedgraph-demo.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=analysisworker
Group=analysisworker
WorkingDirectory=/opt/breedgraph-demo/checkout/src
EnvironmentFile=/opt/breedgraph-demo/analysis-worker-demo.env
ExecStart=/opt/breedgraph-demo/checkout/.venv/bin/python -m analysis_worker.main
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
# R makes its session's directory in /tmp, which ProtectSystem=strict leaves read-only
PrivateTmp=yes
ReadWritePaths=/opt/breedgraph-demo/logs/analysis-worker
StandardOutput=journal
StandardError=journal
SyslogIdentifier=analysis-worker-demo
