# /etc/systemd/system/analysis-worker-demo.service: an analysis worker for the demonstration site's API, as
# instance/analysis_worker.service runs production's (R with the packages it lists)
[Unit]
Description=Analysis worker for the BreedGraph demonstration site
After=network.target breedgraph-demo.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=analysisworker
Group=analysisworker
WorkingDirectory=/opt/breedgraph-demo/checkout/src
EnvironmentFile=/opt/breedgraph-demo/breedgraph-demo.env
ExecStart=/opt/breedgraph-demo/checkout/.venv/bin/python -m analysis_worker.main
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/breedgraph-demo/logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=analysis-worker-demo

[Install]
WantedBy=multi-user.target
