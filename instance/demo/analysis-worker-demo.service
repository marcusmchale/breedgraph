# /etc/systemd/system/analysis-worker-demo.service: an analysis worker for the demonstration site's API, on this
# machine, as instance/analysis_worker.service runs production's (R with the packages it lists); started with
# breedgraph-demo.target. Its environment is its own (analysis-worker-demo.env), so it holds none of the API's secrets.
[Unit]
Description=Analysis worker for the BreedGraph demonstration site
After=network.target breedgraph-demo.service
PartOf=breedgraph-demo.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
# within the site's share of the machine (breedgraph-demo.slice)
Slice=breedgraph-demo.slice
Type=simple
User=analysisworker
Group=analysisworker
WorkingDirectory=/opt/breedgraph-demo/checkout/src
EnvironmentFile=/opt/breedgraph-demo/analysis-worker-demo.env
ExecStart=/opt/breedgraph-demo/checkout/.venv/bin/python -m analysis_worker.main
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
# Memory, so that visitors' analyses leave production's alone. The worker runs one analysis at a time, in a process of
# its own, which may reserve 1.5 GB (LimitAS, for each of the worker's processes), past which an allocation fails and
# the analysis is reported as needing more memory: a process starts at about 0.75 GB, and a mixed model of 3000 rows
# with Kenward-Roger degrees of freedom peaks at about 0.65 GB in use. The worker may use 2 GB in all (MemoryMax),
# past which the kernel ends the analysis's process, which the worker reports, going on with the next
# (OOMPolicy=continue). BLAS runs one thread (analysis-worker-demo.env), as each thread reserves memory of its own.
LimitAS=1536M
MemoryMax=2G
OOMPolicy=continue
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
# R makes its session's directory in /tmp, which ProtectSystem=strict leaves read-only
PrivateTmp=yes
ReadWritePaths=/opt/breedgraph-demo/logs/analysis-worker
StandardOutput=journal
StandardError=journal
SyslogIdentifier=analysis-worker-demo
