# /opt/breedgraph-demo/analysis-worker-demo.env (mode 0600, owned by root): the demonstration site's analysis worker
# (analysis-worker-demo.service), pointed at the site's API. The token is the one in breedgraph-demo.env.
API_URL="http://127.0.0.1:8001"
ANALYSIS_WORKER_AUTH_TOKEN="<the site's ANALYSIS_WORKER_AUTH_TOKEN>"
ANALYSIS_POLL_INTERVAL=5
LOG_BASE="/opt/breedgraph-demo/logs/analysis-worker"
LOG_LEVEL="INFO"
# BLAS on one thread: each thread reserves memory, which counts against the unit's LimitAS
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
