# /opt/breedgraph-demo/archive-worker-demo.env (mode 0600, owned by root): the demonstration site's archive worker
# (archive-worker-demo.service), pointed at the site's API. The token is the one in breedgraph-demo.env.
API_URL="http://127.0.0.1:8001"
ARCHIVE_AUTH_TOKEN="<the site's ARCHIVE_AUTH_TOKEN>"
ARCHIVE_DESTINATION="/opt/breedgraph-demo/archive"
ARCHIVE_POLL_INTERVAL=5
LOG_BASE="/opt/breedgraph-demo/logs"
ARCHIVE_LOG="archive-worker.log"
LOG_LEVEL="INFO"
