# Settings for scripts/sync_database_backups.sh on the archive server.
# Copy to /etc/breedgraph/backup_sync.env there (or set BACKUP_SYNC_ENV to its path).
# Unrelated to the file archive worker (archive_worker.env).

# ssh destination of the web server
BACKUP_SOURCE="breedgraph@web.example.org"

# On the web server: match NEO4J_ARCHIVE_PATH and PERSON_ERASURE_LOG_PATH in breedgraph.env, as absolute paths, or,
# where the web server restricts the key to a directory (rrsync -ro <directory>), as paths from that directory, e.g.
# "/neo4j_dumps" (docs/backups.md)
NEO4J_ARCHIVE_PATH="/path/to/neo4j_dumps"
PERSON_ERASURE_LOG_PATH="/path/to/breedgraph/instance/person_erasure_log.jsonl"

# On this server
BACKUP_DESTINATION_PATH="/srv/breedgraph_backups"

# Remove dumps older than this many days. Leave empty to keep all. The erasure log is always kept.
BACKUP_RETENTION_DAYS=""
