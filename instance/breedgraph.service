# sample file for /etc/systemd/system/breedgraph.service
[Unit]
Description=BreedGraph Application
After=network.target neo4j.service redis.service
# Wants=, not Requires=: scripts/backup.sh stops Neo4j each night, and Requires= has systemd stop the API with it,
# and not start it again. The API reconnects once Neo4j is back.
Wants=network.target neo4j.service redis.service

[Service]
User=breedgraph
Group=breedgraph

WorkingDirectory=/opt/breedgraph
EnvironmentFile=/opt/breedgraph/breedgraph.env

ExecStart=/opt/breedgraph/.venv/bin/uvicorn \
    breedgraph.main:app \
    --host 127.0.0.1 \
    --port 8000

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target