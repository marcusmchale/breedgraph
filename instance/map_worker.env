API_URL="http://localhost:8000"
MAP_POLL_INTERVAL=5
# where the worker cuts files before sending them, on a disk with room for the largest (the API's MAP_REGION_MAX_GB)
MAP_WORK_PATH="map_work"
# where the extracts cut are kept and sent again rather than cut again, on MAP_WORK_PATH's disk; the demonstration site's
# worker shares it (instance/demo/map-worker-demo.env). Empty to keep none.
MAP_CACHE_PATH="map_cache"
MAP_PMTILES_COMMAND="pmtiles"
GEOBOUNDARIES_URL="https://www.geoboundaries.org/api/current/gbOpen"
PROTOMAPS_BUILDS_URL="https://build-metadata.protomaps.dev/builds.json"
# GeoNames' places, for the place search, kept in MAP_CACHE_PATH until asked for fresh
GEONAMES_URL="https://download.geonames.org/export/dump"
LOG_BASE="."
LOG_LEVEL="INFO"
#MAP_LOG="map.log"
