# Neo4j Configuration
# Although you can't have multiple db in community edition
# you might consider using the plugin from https://dozerdb.org/
# particularly for testing etc.

# or "development"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Alternatively you can just change the db name here and in the neo4j conf and restart when you are doing testing
DATABASE_NAME="neo4j"
NEO4J_USERNAME="USERNAME_HERE"
NEO4J_PASSWORD="PASSWORD_HERE"
# The hosts and ports of Neo4j (bolt) and Redis when not the defaults (localhost, 7687 and 6379), e.g. for a second
# instance such as the hosted demo, or the throwaway services of scripts/scratch_services.sh
#DB_HOST=localhost
#DB_PORT=7688
#REDIS_HOST=localhost
#REDIS_PORT=6380

# Mail host configuration
MAIL_HOST='gmail.com'
MAIL_PORT=465
MAIL_USERNAME="USERNAME_HERE"
MAIL_PASSWORD="PASSWORD_HERE"
MAIL_FROM="${MAIL_USERNAME}@${MAIL_HOST}"

MAIL_USE_TLS=1
# If using unauthenticated service set the below to 0
# this will ignore username, password and TLS options.
MAIL_AUTHENTICATED=1

# Log files
LOG_BASE="/path/to/logs"
BREEDGRAPH_LOG="breedgraph.log"
GRAPHQL_LOG="graphql.log"
NEO4J_LOG="neo4j.log"
REDIS_LOG="redis.log"
ACCESS_LOG="access.log"

# Secret keys
SECRET_KEY='have-a-crack-at-it'
VERIFY_TOKEN_SALT="slip-that-over-your-laughing-gear"
 # in minutes
VERIFY_EXPIRES=1440
PASSWORD_RESET_SALT="ZOMFG-How-COULD-y0u-FORGETZ"
 # in minutes
PASSWORD_RESET_EXPIRES=60
LOGIN_SALT="Since-you-asked-so-nicely"
 # in minutes
LOGIN_EXPIRES=10080
CSRF_SALT='tell-me-who-is-asking'
CSRF_EXPIRES=3600
# acceptances of the Terms of Use and of study licences (docs/licences.md §4), in minutes
ACCEPTANCE_SALT=change-me
ACCEPTANCE_EXPIRES_SIGNED_IN=525600
ACCEPTANCE_EXPIRES_ANONYMOUS=10080

# Hosting environment
PROTOCOL="http"
SITE_NAME='BreedGraph'
HOST_ADDRESS='localhost'
HOST_PORT=8000
GRAPHQL_API_PATH='graphql'
VUE_PORT=8080
# The path the site is served under, behind a proxy that strips it (e.g. /demo for the demonstration site beside
# production, instance/demo/README.md); empty at the host's root. Every link the API gives starts with it
SITE_PATH=''
# What the API's cookie names start with, e.g. demo_ for a site under SITE_PATH beside another on the same host
COOKIE_PREFIX=''
# Where the API listens on this machine (instance/breedgraph.service), for scripts/trigger_retention.py
API_URL="http://127.0.0.1:8000"

# Files
FILE_STORAGE_PATH="./file_store"
# Where uploads are held while they are received (Python's temporary directory, /tmp by default): a directory on the
# disk with room for the largest uploads at once, such as one beside FILE_STORAGE_PATH (README, Nginx)
#TMPDIR="/path/to/tmp"
FILE_DOWNLOAD_SALT="PROVIDE_SALT_FOR_DOWNLOAD_LINKS"
FILE_DOWNLOAD_EXPIRES=1440
# the most uploaded files saved at once: an upload asked for while they are all taken is refused, to try again later
MAX_CONCURRENT_UPLOADS=5
# legal references given as files (.txt, .md or .pdf): the largest file in bytes, and the most pages of a PDF
LEGAL_FILE_SIZE_LIMIT=5000000
LEGAL_FILE_PAGE_LIMIT=200

# Archive
# The services' tokens: the archive, analysis and map workers' are in their own env files too
ARCHIVE_AUTH_TOKEN="S3T_L0Ng_Complex-T%ken-H3R3"
RETENTION_AUTH_TOKEN="AN0THER_Complex-T%ken-PL|Z"
ANALYSIS_WORKER_AUTH_TOKEN="M0RE_Complex-T%kenZs"
MAP_WORKER_AUTH_TOKEN="Y3T_An0ther-T%ken-M4PS"
LOCAL_STORAGE_DURATION=28
LOCAL_SIZE_LIMIT=10000000
# how many times a file is offered to the archive worker, to archive or to retrieve, before it fails
ARCHIVE_ATTEMPT_LIMIT=5
RETRIEVE_ATTEMPT_LIMIT=5

# Analyses: seconds a leased job may run before it is queued again
ANALYSIS_JOB_LEASE_SECONDS=3600

# Retention, in days: dataset submissions and analyses in Redis, and file references nothing cites
SUBMISSION_RETENTION_DAYS=7
ANALYSIS_RETENTION_DAYS=7
UNUSED_REFERENCE_RETENTION_DAYS=7

# Passwords: the least length, and the least uppercase letters, numbers and special characters
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_UPPERCASE=1
PASSWORD_MIN_NUMBERS=1
PASSWORD_MIN_SPECIAL=1

# Data
# The countries offered when adding a location, which is in neither the repository nor the wheel: the UN's M49
# overview (https://unstats.un.org/unsd/methodology/m49/overview/) downloaded as CSV, its columns separated by
# semicolons, of which 'Country or Area' and 'ISO-alpha3 Code' are read. Without it only the countries already added
# are offered.
COUNTRY_CODES_PATH="country_codes.csv"

# Database backups: scripts/backup.sh writes Neo4j dumps here, scripts/restore.sh loads them,
# and scripts/sync_database_backups.sh on the archive server copies them. Unrelated to the file archive worker.
NEO4J_ARCHIVE_PATH="/path/to/neo4j_dumps"

# Encryption of database backups and archived files with age (README, "Encryption key"): the public key "age1...",
# and the private key file. Leave them empty only with ENVIRONMENT="development", which leaves both unencrypted.
ENCRYPTION_RECIPIENT=""
ENCRYPTION_IDENTITY_PATH=""

# Log of erased Persons (ids and times only), replayed after a restore. Copied with the database dumps.
PERSON_ERASURE_LOG_PATH="instance/person_erasure_log.jsonl"

# The published Terms of Use and privacy notice, as markdown (docs/licences.md §4). Leave them empty for the copies
# packaged with the API, src/breedgraph/legal/terms_of_use.md and privacy_notice.md.
TERMS_OF_USE_PATH=""
PRIVACY_NOTICE_PATH=""

# Maps (README.md, Maps): place searches go to Nominatim from the server, limited per user per hour; tiles are served
# from MAP_TILES_PATH at /tiles (nginx serves them in production). scripts/map_tiles.py cuts the world file, and the
# API fetches detailed regions with the pmtiles command, dividing countries larger than MAP_REGION_MAX_GB. Leave
# MAP_PMTILES_COMMAND empty to fetch none. MAP_TILES_BUILD is "latest" or a Protomaps build's URL.
# With MAP_WORKER=1 the map worker, on a server with internet access, fetches for the API and the script, which then
# need neither pmtiles nor internet access: MAP_WORKER_AUTH_TOKEN above, its lease MAP_JOB_LEASE_SECONDS.
# MAP_TILES_MAX_GB caps the regions' files together (0 for no cap but the disk's).
NOMINATIM_URL="https://nominatim.openstreetmap.org"
GEOCODING_RATE_LIMIT_PER_HOUR=120
MAP_TILES_PATH="instance/map_tiles"
MAP_REGION_MAX_GB=2
MAP_TILES_MAX_GB=0
MAP_TILES_BUILD="latest"
MAP_PMTILES_COMMAND="pmtiles"
MAP_WORKER=0
MAP_JOB_LEASE_SECONDS=300
MAP_BOUNDARIES_PATH="instance/map_boundaries"
GEOBOUNDARIES_URL="https://www.geoboundaries.org/api/current/gbOpen"
PROTOMAPS_BUILDS_URL="https://build-metadata.protomaps.dev/builds.json"

# Invitations to register
INVITATION_EXPIRY_DAYS=30
INVITATION_SALT="CHANGE_ME"

# Each hour: the emails a user's actions send to addresses they give (invitations, a new address's verification), and
# the password resets asked for one address (src/breedgraph/config/emails.py)
EMAIL_RATE_LIMIT_PER_HOUR=20
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3

# Messages to contacts
MESSAGE_RATE_LIMIT_PER_HOUR=10
MESSAGE_MAX_LENGTH=5000
MESSAGE_SUBJECT_MAX_LENGTH=200

# The largest GraphQL query answered: fields nested, fields asked for (aliases counted), lists nested
# (src/breedgraph/config/queries.py)
MAX_QUERY_DEPTH=15
MAX_QUERY_FIELDS=2000
MAX_QUERY_LISTS=6

# ORCID Public API client, for users to link a verified ORCID iD. Linking is not available while empty.
# https://sandbox.orcid.org for testing, https://orcid.org in production.
# ORCID_REDIRECT_URI is the front-end /orcid page, and must be registered with ORCID; it defaults to PROTOCOL://HOST_ADDRESS:VUE_PORT/orcid (no port for 80 and 443).
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_BASE_URL="https://sandbox.orcid.org"
#ORCID_REDIRECT_URI="https://breedgraph.example.org/orcid"
ORCID_STATE_EXPIRES_SECONDS=600
